# Copy to .env and fill in. .env is gitignored — never commit it.
#
#   cp .env.example .env
#
# Get the API key from your n8n instance: Settings -> n8n API -> Create an API key.
# Set an expiry if your version supports it. This key grants full read/write/execute
# access to every workflow and credential reference on the instance — treat it like
# a root password.

# No trailing slash. e.g. http://localhost:5678
N8N_BASE_URL=

# The API key itself. Paste it here, not into a chat window.
N8N_API_KEY=

# Webhook that scripts/scheduled-destroy.sh POSTs the teardown result to.
# Optional -- defaults to $N8N_BASE_URL/webhook/destroy-status.
#
# Note the two forms n8n exposes:
#   /webhook/destroy-status        PRODUCTION -- only works when the workflow is ACTIVE
#   /webhook-test/destroy-status   TEST -- only works while the editor is open with
#                                  "Listen for test event" clicked
# A 404 from the production URL almost always means the workflow is not active.
N8N_WEBHOOK_URL=
